      "version": 1,
      "versionNonce": 371044854,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Protected files (pull-back never overwrites them): the dashboard, API data snapshots, replay records, the source manifest,\nand existing query files and results. Scripts may add new files, such as their own results.\nJunk (never pulled back): __pycache__, caches, temporary files.\nFingerprints are saved with the sandbox id, so the next call or turn pushes only what changed. Solid arrow = request, dashed arrow = reply.",
      "originalText": "Protected files (pull-back never overwrites them): the dashboard, API data snapshots, replay records, the source manifest,\nand existing query files and results. Scripts may add new files, such as their own results.\nJunk (never pulled back): __pycache__, caches, temporary files.\nFingerprints are saved with the sandbox id, so the next call or turn pushes only what changed. Solid arrow = request, dashed arrow = reply.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 75,
      "autoResize": true
    }
