      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1767063625,
      "version": 1,
      "versionNonce": 1914290651,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• The sandbox is not deleted when the turn ends. It is reused by later turns and shuts down on its own when idle.\n• The sandbox never talks to MinIO or the AI model. Only the agent service does.\n• Uploaded files are not in the snapshot zip. They are cached on the agent service and pushed to the sandbox from there.\n• The sandbox record (sandbox id + fingerprints of pushed files) is saved in the snapshot, so any agent-service pod can reuse the sandbox.",
      "originalText": "• The sandbox is not deleted when the turn ends. It is reused by later turns and shuts down on its own when idle.\n• The sandbox never talks to MinIO or the AI model. Only the agent service does.\n• Uploaded files are not in the snapshot zip. They are cached on the agent service and pushed to the sandbox from there.\n• The sandbox record (sandbox id + fingerprints of pushed files) is saved in the snapshot, so any agent-service pod can reuse the sandbox.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 75,
      "autoResize": true
    }
